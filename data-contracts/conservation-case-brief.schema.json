{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inforsight.example/contracts/conservation-case-brief.schema.json",
  "title": "ConservationCaseBrief",
  "description": "Structured, grounded decision-support brief generated by the bounded case intelligence assistant for human conservation review under ADR 0002.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "brief_id",
    "case_id",
    "policy_id",
    "as_of_date",
    "generated_at",
    "synthesis_mode",
    "status",
    "authorized_to_act",
    "executive_summary",
    "risk_assessment",
    "factual_timeline",
    "intervention_recommendations",
    "disqualified_actions",
    "grounding_audit",
    "disclaimer"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this conservation-case-brief schema contract.",
      "type": "string",
      "const": "1.0.0"
    },
    "brief_id": {
      "description": "Unique identifier for this generated case brief.",
      "type": "string",
      "pattern": "^brf_[a-z0-9_]{8,64}$"
    },
    "case_id": {
      "description": "Identifier of the associated conservation case.",
      "type": "string",
      "pattern": "^case_[a-z0-9_]{8,64}$"
    },
    "policy_id": {
      "description": "Identifier of the associated policy.",
      "type": "string",
      "pattern": "^pol_[a-z0-9_]{4,64}$"
    },
    "as_of_date": {
      "description": "RFC 3339 UTC observation cutoff timestamp.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "generated_at": {
      "description": "RFC 3339 UTC brief generation timestamp.",
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "synthesis_mode": {
      "description": "Synthesis mode used to produce the brief.",
      "type": "string",
      "enum": ["TEMPLATE_DETERMINISTIC", "LLM_AUGMENTED_GROUNDED"]
    },
    "status": {
      "description": "ADR 0002 mandatory review status. Must always be PENDING_HUMAN_REVIEW upon generation.",
      "type": "string",
      "const": "PENDING_HUMAN_REVIEW"
    },
    "authorized_to_act": {
      "description": "ADR 0002 boundary marker. The assistant conveys zero authority to execute outreach or alter policies.",
      "type": "boolean",
      "const": false
    },
    "executive_summary": {
      "description": "High-level summary of policy standing, risk factors, and urgency.",
      "type": "object",
      "additionalProperties": false,
      "required": ["headline", "operational_urgency", "narrative"],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 5,
          "maxLength": 200
        },
        "operational_urgency": {
          "type": "string",
          "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL"]
        },
        "narrative": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2000
        }
      }
    },
    "risk_assessment": {
      "description": "Calibrated risk scores and SHAP feature attributions.",
      "type": "object",
      "additionalProperties": false,
      "required": ["calibrated_probability", "operational_tier", "top_risk_drivers"],
      "properties": {
        "calibrated_probability": {
          "type": "number",
          "minimum": 0.0,
          "maximum": 1.0
        },
        "operational_tier": {
          "type": "string"
        },
        "top_risk_drivers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["feature_name", "attribution", "display_text"],
            "properties": {
              "feature_name": { "type": "string" },
              "attribution": { "type": "number" },
              "display_text": { "type": "string" }
            }
          }
        }
      }
    },
    "factual_timeline": {
      "description": "Chronological history of factual events leading up to the observation cutoff.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["occurred_at", "event_type", "summary"],
        "properties": {
          "occurred_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "Z$"
          },
          "event_type": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "intervention_recommendations": {
      "description": "Recommended interventions derived from eligibility and optimization.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_action",
        "uplift_quadrant",
        "expected_net_utility",
        "talking_points",
        "alternative_actions"
      ],
      "properties": {
        "primary_action": { "type": "string" },
        "uplift_quadrant": {
          "type": "string",
          "enum": ["PERSUADABLE", "LOST_CAUSE", "SURE_THING", "SLEEPING_DOG"]
        },
        "expected_net_utility": { "type": "number" },
        "talking_points": {
          "type": "array",
          "items": { "type": "string" }
        },
        "alternative_actions": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "disqualified_actions": {
      "description": "Actions disqualified by the deterministic rules engine.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "reason_code", "description"],
        "properties": {
          "action_id": { "type": "string" },
          "reason_code": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "grounding_audit": {
      "description": "Results of automated post-processing grounding verification.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_status",
        "verified_entity_count",
        "hallucination_detected",
        "violations"
      ],
      "properties": {
        "validation_status": {
          "type": "string",
          "enum": ["PASSED_CLEAN", "PASSED_WITH_REDACTION", "FALLBACK_TO_TEMPLATE"]
        },
        "verified_entity_count": {
          "type": "integer",
          "minimum": 0
        },
        "hallucination_detected": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "disclaimer": {
      "description": "Mandatory advisory disclaimer.",
      "type": "string",
      "minLength": 20
    }
  }
}

