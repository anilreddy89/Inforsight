{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anilreddy89/Inforsight/schemas/policy-event/1.0.0",
  "title": "Inforsight policy event",
  "description": "Shared envelope for an immutable event in a fictional policy history.",
  "type": "object",
  "additionalProperties": false,
  "oneOf": [
    {
      "$ref": "#/$defs/policy_issued_event"
    },
    {
      "$ref": "#/$defs/policy_status_changed_event"
    },
    {
      "$ref": "#/$defs/billing_premium_due_event"
    },
    {
      "$ref": "#/$defs/payment_received_event"
    },
    {
      "$ref": "#/$defs/payment_failed_event"
    },
    {
      "$ref": "#/$defs/notice_sent_event"
    },
    {
      "$ref": "#/$defs/service_contact_recorded_event"
    },
    {
      "$ref": "#/$defs/outcome_lapsed_event"
    },
    {
      "$ref": "#/$defs/outcome_surrendered_event"
    }
  ],
  "required": [
    "schema_version",
    "event_id",
    "policy_id",
    "event_type",
    "occurred_at",
    "effective_at",
    "ingested_at",
    "payload"
  ],
  "properties": {
    "schema_version": {
      "description": "Version of this policy-event envelope contract.",
      "const": "1.0.0"
    },
    "event_id": {
      "description": "Synthetic identifier for this immutable event.",
      "type": "string",
      "pattern": "^evt_[a-z0-9]{12,64}$"
    },
    "policy_id": {
      "description": "Synthetic identifier for the fictional policy.",
      "type": "string",
      "pattern": "^pol_[a-z0-9]{12,64}$"
    },
    "event_type": {
      "description": "Stable, namespaced name used to select an event-specific payload contract.",
      "type": "string",
      "enum": [
        "policy.issued",
        "policy.status_changed",
        "billing.premium_due",
        "payment.received",
        "payment.failed",
        "notice.sent",
        "service.contact_recorded",
        "outcome.lapsed",
        "outcome.surrendered"
      ]
    },
    "occurred_at": {
      "description": "UTC instant when the fictional event occurred.",
      "$ref": "#/$defs/utc_timestamp"
    },
    "effective_at": {
      "description": "UTC instant from which the event affects reconstructed policy state.",
      "$ref": "#/$defs/utc_timestamp"
    },
    "ingested_at": {
      "description": "UTC instant when Inforsight learned about the event.",
      "$ref": "#/$defs/utc_timestamp"
    },
    "payload": {
      "description": "Event-specific fictional facts selected by event_type.",
      "type": "object"
    }
  },
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "policy_issued_event": {
      "properties": {
        "event_type": {
          "const": "policy.issued"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/policy/1.0.0#/$defs/issued"
        }
      }
    },
    "policy_status_changed_event": {
      "properties": {
        "event_type": {
          "const": "policy.status_changed"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/policy/1.0.0#/$defs/status_changed"
        }
      }
    },
    "billing_premium_due_event": {
      "properties": {
        "event_type": {
          "const": "billing.premium_due"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/billing/1.0.0#/$defs/premium_due"
        }
      }
    },
    "payment_received_event": {
      "properties": {
        "event_type": {
          "const": "payment.received"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/payment/1.0.0#/$defs/received"
        }
      }
    },
    "payment_failed_event": {
      "properties": {
        "event_type": {
          "const": "payment.failed"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/payment/1.0.0#/$defs/failed"
        }
      }
    },
    "notice_sent_event": {
      "properties": {
        "event_type": {
          "const": "notice.sent"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/notice/1.0.0#/$defs/sent"
        }
      }
    },
    "service_contact_recorded_event": {
      "properties": {
        "event_type": {
          "const": "service.contact_recorded"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/service/1.0.0#/$defs/contact_recorded"
        }
      }
    },
    "outcome_lapsed_event": {
      "properties": {
        "event_type": {
          "const": "outcome.lapsed"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/outcome/1.0.0#/$defs/lapsed"
        }
      }
    },
    "outcome_surrendered_event": {
      "properties": {
        "event_type": {
          "const": "outcome.surrendered"
        },
        "payload": {
          "$ref": "https://github.com/anilreddy89/Inforsight/schemas/payloads/outcome/1.0.0#/$defs/surrendered"
        }
      }
    }
  }
}
