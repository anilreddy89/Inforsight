{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anilreddy89/Inforsight/schemas/v2/policy-event/2.0.0",
  "title": "Inforsight v2 synthetic policy event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "policy_id", "event_type", "occurred_at", "effective_at", "ingested_at", "payload"],
  "properties": {
    "schema_version": {"const": "2.0.0"},
    "event_id": {"type": "string", "pattern": "^evt_[0-9a-f]{24}$"},
    "policy_id": {"type": "string", "pattern": "^pol_[0-9a-f]{24}$"},
    "event_type": {"enum": ["policy.issued", "behavior.snapshot", "policy.grace_entered", "policy.grace_recovered", "event.corrected", "outcome.lapsed", "outcome.surrendered"]},
    "occurred_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "effective_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "ingested_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "payload": {"type": "object"}
  }
}
