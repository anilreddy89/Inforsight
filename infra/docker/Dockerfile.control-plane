# Multi-stage Java 21 / Spring Boot 3 control-plane image.

FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /build

COPY services/control-plane/pom.xml services/control-plane/pom.xml
COPY services/control-plane/src services/control-plane/src
RUN mvn -B -f services/control-plane/pom.xml -DskipTests package

FROM eclipse-temurin:21-jre-alpine AS runner

WORKDIR /app

RUN addgroup -S inforsight && adduser -S inforsight -G inforsight
COPY --from=builder --chown=inforsight:inforsight \
    /build/services/control-plane/target/control-plane-0.1.0-SNAPSHOT.jar /app/app.jar
USER inforsight:inforsight

ENV JAVA_OPTS="-XX:MaxRAMPercentage=75 -Djava.security.egd=file:/dev/./urandom"

EXPOSE 8080

ENTRYPOINT ["sh", "-c", "exec java $JAVA_OPTS -jar /app/app.jar"]
