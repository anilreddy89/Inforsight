FROM python:3.12-slim
WORKDIR /app
COPY serving/requirements.txt /app/requirements.txt
COPY simulator/pyproject.toml /app/simulator/pyproject.toml
COPY simulator/src /app/simulator/src
COPY demo_runtime/simulator_package_init.py /app/simulator/src/inforsight_simulator/__init__.py
RUN pip install --no-cache-dir --no-deps /app/simulator \
    && pip install --no-cache-dir -r requirements.txt numpy==2.2.6 jsonschema==4.26.0 referencing==0.37.0 rfc3339-validator==0.1.4
COPY data-contracts /app/data-contracts
COPY docs/modeling /app/docs/modeling
COPY docs/experiments/phase-02-10-model-bundle.json /app/docs/experiments/phase-02-10-model-bundle.json
COPY agents /app/agents
COPY demo_runtime /app/demo_runtime
RUN useradd --system --uid 10001 --home /app inforsight
ENV PYTHONPATH=/app:/app/simulator/src
USER inforsight
EXPOSE 8001
HEALTHCHECK --interval=10s --timeout=5s --start-period=20s --retries=5 CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8001/health', timeout=3)"
CMD ["uvicorn", "demo_runtime.app:app", "--host", "0.0.0.0", "--port", "8001"]
